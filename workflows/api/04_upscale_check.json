{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "_meta": { "title": "CHECKPOINT" },
    "inputs": {
      "ckpt_name": "illustriousXL.safetensors"
    }
  },
  "2": {
    "class_type": "CLIPSetLastLayer",
    "_meta": { "title": "CLIP_SKIP" },
    "inputs": {
      "clip": ["1", 1],
      "stop_at_clip_layer": -2
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "POSITIVE" },
    "inputs": {
      "clip": ["2", 0],
      "text": "masterpiece, best quality, absurdres, highly detailed material texture, crisp lineart"
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "NEGATIVE" },
    "inputs": {
      "clip": ["2", 0],
      "text": "worst quality, low quality, blurry, jpeg artifacts, oversharpened"
    }
  },
  "5": {
    "class_type": "LoadImage",
    "_meta": { "title": "INPUT_IMAGE" },
    "inputs": {
      "image": "selected_concept.png",
      "upload": "image"
    }
  },
  "6": {
    "class_type": "UpscaleModelLoader",
    "_meta": { "title": "UPSCALE_MODEL" },
    "inputs": {
      "model_name": "4x-AnimeSharp.pth"
    }
  },
  "7": {
    "class_type": "ImageUpscaleWithModel",
    "_meta": { "title": "UPSCALE" },
    "inputs": {
      "upscale_model": ["6", 0],
      "image": ["5", 0]
    }
  },
  "8": {
    "class_type": "ImageScaleBy",
    "_meta": { "title": "DOWNSCALE" },
    "inputs": {
      "image": ["7", 0],
      "upscale_method": "lanczos",
      "scale_by": 0.5
    }
  },
  "9": {
    "class_type": "VAEEncode",
    "_meta": { "title": "ENCODE" },
    "inputs": {
      "pixels": ["8", 0],
      "vae": ["1", 2]
    }
  },
  "10": {
    "class_type": "KSampler",
    "_meta": { "title": "SAMPLER" },
    "inputs": {
      "model": ["1", 0],
      "positive": ["3", 0],
      "negative": ["4", 0],
      "latent_image": ["9", 0],
      "seed": 0,
      "steps": 20,
      "cfg": 4.5,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 0.35
    }
  },
  "11": {
    "class_type": "VAEDecode",
    "_meta": { "title": "DECODE" },
    "inputs": {
      "samples": ["10", 0],
      "vae": ["1", 2]
    }
  },
  "12": {
    "class_type": "SaveImage",
    "_meta": { "title": "SAVE" },
    "inputs": {
      "images": ["11", 0],
      "filename_prefix": "concept/upscale_check"
    }
  }
}
